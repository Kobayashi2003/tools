<UserControl x:Class="QuickLook.Plugin.FolderViewer.FolderView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickLook.Plugin.FolderViewer"
             Foreground="{DynamicResource WindowTextForeground}"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <local:IconConverter x:Key="IconConverter" />
        <local:ExpanderGlyphConverter x:Key="ExpanderGlyphConverter" />
        <local:BoolToHiddenConverter x:Key="BoolToHiddenConverter" />

        <!-- Translucent grey reads on both QuickLook themes and over its blurred backdrop. -->
        <SolidColorBrush x:Key="RowHoverBrush" Color="#1A808080" />
        <SolidColorBrush x:Key="RowSelectedBrush" Color="#3A808080" />
        <SolidColorBrush x:Key="DividerBrush" Color="#33808080" />
        <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Explicit styles: QuickLook's app-wide control theme does not lay out GridView rows. -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextForegroundAlternative}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Padding="10,6"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   Width="8"
                                   Margin="0,0,-4,0"
                                   HorizontalAlignment="Right"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <Rectangle Width="1"
                                                       Margin="0,7"
                                                       HorizontalAlignment="Center"
                                                       Fill="{StaticResource DividerBrush}" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Margin="0,1"
                                Background="Transparent"
                                CornerRadius="4">
                            <GridViewRowPresenter VerticalAlignment="Center"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WindowTextForeground}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,0,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="4,4,4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="FolderIcon"
                   Width="32"
                   Height="32"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="FolderName"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FolderPath"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TotalSize"
                           HorizontalAlignment="Right"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="TotalCount"
                           Margin="0,2,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            </StackPanel>
        </Grid>

        <ListView x:Name="List"
                  Grid.Row="1"
                  ContextMenuOpening="OnContextMenuOpening"
                  GridViewColumnHeader.Click="OnHeaderClick"
                  KeyDown="OnListKeyDown"
                  MouseDoubleClick="OnListDoubleClick"
                  SizeChanged="OnListSizeChanged">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="OpenItem" Click="OnOpenClick" />
                    <MenuItem x:Name="RevealItem" Click="OnRevealClick" />
                    <MenuItem x:Name="CopyPathItem" Click="OnCopyPathClick" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="NameColumn" Width="420">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="NameHeader" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border Width="{Binding Indent}" DockPanel.Dock="Left" />
                                    <TextBlock Width="16"
                                               VerticalAlignment="Center"
                                               Background="Transparent"
                                               Cursor="Hand"
                                               DockPanel.Dock="Left"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="9"
                                               Foreground="{DynamicResource WindowTextForegroundAlternative}"
                                               MouseLeftButtonDown="OnExpanderMouseDown"
                                               Tag="Expander"
                                               Text="{Binding IsExpanded, Converter={StaticResource ExpanderGlyphConverter}}"
                                               TextAlignment="Center"
                                               Visibility="{Binding CanExpand, Converter={StaticResource BoolToHiddenConverter}}" />
                                    <Image Width="16"
                                           Height="16"
                                           Margin="4,0,8,0"
                                           DockPanel.Dock="Left"
                                           Source="{Binding Converter={StaticResource IconConverter}, Mode=OneTime}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ToolTip}" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="SizeColumn" Width="100">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="SizeHeader" HorizontalContentAlignment="Right" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,4,0"
                                           Text="{Binding SizeText}"
                                           TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TypeColumn" Width="160">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="TypeHeader" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource WindowTextForegroundAlternative}"
                                           Text="{Binding TypeName, Mode=OneTime}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ModifiedColumn" Width="140">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="ModifiedHeader" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource WindowTextForegroundAlternative}" Text="{Binding ModifiedText, Mode=OneTime}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource WindowTextForegroundAlternative}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <DockPanel x:Name="StatusBar"
                   Grid.Row="2"
                   Margin="4,8,4,0">
            <ProgressBar x:Name="ScanProgress"
                         Width="80"
                         Height="4"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         DockPanel.Dock="Left"
                         IsIndeterminate="True" />
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
