{
  "manifest_version": 3,
  "name": "X Media Downloader",
  "version": "1.1",
  "description": "Download original-quality images / videos / GIFs from X (Twitter) by double-clicking, modifier + click, or a toolbar button. Optionally like the post at the same time.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://abs.twimg.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
