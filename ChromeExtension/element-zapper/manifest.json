{
  "manifest_version": 3,
  "name": "Element Zapper",
  "version": "1.0",
  "description": "Hold a trigger key (configurable) and click any page element to delete it. Press Ctrl/Cmd+Z to undo.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
