{
  "manifest_version": 3,
  "name": "Page Screenshot",
  "version": "1.0",
  "description": "Capture the visible area instantly, or auto-scroll and stitch the whole page into one PNG.",
  "permissions": ["downloads", "scripting", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Page Screenshot"
  }
}
