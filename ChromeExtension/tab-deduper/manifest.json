{
  "manifest_version": 3,
  "name": "Tab Deduper",
  "version": "1.0",
  "description": "Automatically closes duplicate tabs, keeping the first one opened.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}