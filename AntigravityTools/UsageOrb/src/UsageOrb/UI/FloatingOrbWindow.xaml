<Window x:Class="UsageOrb.UI.FloatingOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageOrb.UI.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="46"
        Height="46">
    <Grid Background="Transparent" Cursor="Hand">
        <!-- 1A. Concentric Dual-Ring Circular Orb (Default) -->
        <controls:OrbRingCanvas x:Name="OrbCanvas" Margin="3" />

        <!-- 1B. Compact 3-Metric Pill (Toggleable) -->
        <Border x:Name="PillContainer"
                Visibility="Collapsed"
                Margin="3"
                CornerRadius="15"
                Background="{DynamicResource OrbFillBrush}"
                BorderBrush="{DynamicResource BorderPrimaryBrush}"
                BorderThickness="1"
                Padding="11,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.42" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- CTX -->
                <Ellipse x:Name="PillCtxDot" Width="6" Height="6" Fill="{DynamicResource CyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="CTX" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <TextBlock x:Name="PillCtxVal" Text="0%" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" VerticalAlignment="Center" />

                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource BorderStrongBrush}" Margin="7,0" VerticalAlignment="Center" />

                <!-- 5H -->
                <Ellipse x:Name="Pill5hDot" Width="6" Height="6" Fill="{DynamicResource OkBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="5H" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <TextBlock x:Name="Pill5hVal" Text="100%" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" VerticalAlignment="Center" />

                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource BorderStrongBrush}" Margin="7,0" VerticalAlignment="Center" />

                <!-- WK -->
                <Ellipse x:Name="PillWkDot" Width="6" Height="6" Fill="{DynamicResource WarnBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="WK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <TextBlock x:Name="PillWkVal" Text="100%" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
