<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Style A — Obsidian Glass Light Counterpart -->
    <Color x:Key="BgPrimaryColor">#F6F8FB</Color>
    <Color x:Key="BgSecondaryColor">#FFFFFF</Color>
    <Color x:Key="BgTertiaryColor">#EBF0F6</Color>
    <Color x:Key="BgElevatedColor">#FAFFFFFF</Color>
    <Color x:Key="BgInputColor">#F8FAFC</Color>
    <Color x:Key="BgRowHoverColor">#F1F5F9</Color>
    <Color x:Key="OrbFillColor">#F5FFFFFF</Color>

    <Color x:Key="BorderPrimaryColor">#DCE3EE</Color>
    <Color x:Key="BorderSubtleColor">#EAEFF6</Color>
    <Color x:Key="BorderStrongColor">#C5D0E0</Color>

    <Color x:Key="FgPrimaryColor">#0F172A</Color>
    <Color x:Key="FgSecondaryColor">#475569</Color>
    <Color x:Key="FgMutedColor">#64748B</Color>

    <Color x:Key="CyanColor">#0284C7</Color>
    <Color x:Key="CyanBgColor">#180284C7</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentBgColor">#182563EB</Color>
    <Color x:Key="OkColor">#059669</Color>
    <Color x:Key="OkBgColor">#18059669</Color>
    <Color x:Key="WarnColor">#D97706</Color>
    <Color x:Key="WarnBgColor">#1AD97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerBgColor">#18DC2626</Color>
    <Color x:Key="PurpleColor">#7C3AED</Color>
    <Color x:Key="PurpleBgColor">#187C3AED</Color>
    <Color x:Key="TrackColor">#E2E8F0</Color>

    <!-- Adaptive Hero Card Tints -->
    <Color x:Key="HeroOkBgColor">#F0FDF8</Color>
    <Color x:Key="HeroOkBorderColor">#A7F3D0</Color>
    <Color x:Key="HeroWarnBgColor">#FFFBEB</Color>
    <Color x:Key="HeroWarnBorderColor">#FDE68A</Color>
    <Color x:Key="HeroDangerBgColor">#FEF2F2</Color>
    <Color x:Key="HeroDangerBorderColor">#FECACA</Color>

    <!-- High-Contrast Primary CTA -->
    <Color x:Key="CtaBgColor">#0F172A</Color>
    <Color x:Key="CtaHoverBgColor">#1E293B</Color>
    <Color x:Key="CtaFgColor">#FFFFFF</Color>

    <!-- Slim Scrollbar -->
    <Color x:Key="ScrollThumbColor">#CBD5E1</Color>
    <Color x:Key="ScrollThumbHoverColor">#94A3B8</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiaryColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgRowHoverBrush" Color="{StaticResource BgRowHoverColor}" />
    <SolidColorBrush x:Key="OrbFillBrush" Color="{StaticResource OrbFillColor}" />

    <SolidColorBrush x:Key="BorderPrimaryBrush" Color="{StaticResource BorderPrimaryColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="FgPrimaryBrush" Color="{StaticResource FgPrimaryColor}" />
    <SolidColorBrush x:Key="FgSecondaryBrush" Color="{StaticResource FgSecondaryColor}" />
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}" />

    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="CyanBgBrush" Color="{StaticResource CyanBgColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBgBrush" Color="{StaticResource AccentBgColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkBgBrush" Color="{StaticResource OkBgColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="PurpleBgBrush" Color="{StaticResource PurpleBgColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />

    <SolidColorBrush x:Key="HeroOkBgBrush" Color="{StaticResource HeroOkBgColor}" />
    <SolidColorBrush x:Key="HeroOkBorderBrush" Color="{StaticResource HeroOkBorderColor}" />
    <SolidColorBrush x:Key="HeroWarnBgBrush" Color="{StaticResource HeroWarnBgColor}" />
    <SolidColorBrush x:Key="HeroWarnBorderBrush" Color="{StaticResource HeroWarnBorderColor}" />
    <SolidColorBrush x:Key="HeroDangerBgBrush" Color="{StaticResource HeroDangerBgColor}" />
    <SolidColorBrush x:Key="HeroDangerBorderBrush" Color="{StaticResource HeroDangerBorderColor}" />

    <SolidColorBrush x:Key="CtaBgBrush" Color="{StaticResource CtaBgColor}" />
    <SolidColorBrush x:Key="CtaHoverBgBrush" Color="{StaticResource CtaHoverBgColor}" />
    <SolidColorBrush x:Key="CtaFgBrush" Color="{StaticResource CtaFgColor}" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
</ResourceDictionary>
