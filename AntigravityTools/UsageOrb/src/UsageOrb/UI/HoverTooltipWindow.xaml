<Window x:Class="UsageOrb.UI.HoverTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Margin="8"
            Width="292"
            CornerRadius="12"
            Background="{DynamicResource BgElevatedBrush}"
            BorderBrush="{DynamicResource BorderPrimaryBrush}"
            BorderThickness="1"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.48" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitle"
                           Text="Antigravity Telemetry"
                           Foreground="{DynamicResource FgPrimaryBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border x:Name="StatusPill"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="7,2"
                        CornerRadius="6"
                        Background="{DynamicResource OkBgBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusPillDot" Width="5" Height="5" Fill="{DynamicResource OkBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusPillText"
                                   Text="LIVE"
                                   Foreground="{DynamicResource OkBrush}"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

            <!-- 1. Context Window -->
            <StackPanel Margin="0,0,0,9">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Context Window" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ContextPctText" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" />
                        <TextBlock x:Name="ContextSubText" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource FgMutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Border Height="4.5" CornerRadius="2.25" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                    <Grid x:Name="ContextBarGrid" />
                </Border>
            </StackPanel>

            <!-- 2. 5-Hour Remaining -->
            <StackPanel Margin="0,0,0,9">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="5-Hour Remaining" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                        <Border x:Name="FiveHourModeBadge" Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource BgTertiaryBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="FiveHourModeText" Text="Est." FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FiveHourPctText" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" />
                        <TextBlock x:Name="FiveHourMetaText" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource FgMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Border Height="4.5" CornerRadius="2.25" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                    <Grid x:Name="FiveHourBarGrid" />
                </Border>
            </StackPanel>

            <!-- 3. Weekly Remaining -->
            <StackPanel Margin="0,0,0,10">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Weekly Remaining" Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                        <Border x:Name="WeeklyModeBadge" Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource BgTertiaryBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="WeeklyModeText" Text="Est." FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="WeeklyPctText" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                        <TextBlock x:Name="WeeklyMetaText" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource FgMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Border Height="4.5" CornerRadius="2.25" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                    <Grid x:Name="WeeklyBarGrid" />
                </Border>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,7" />

            <!-- Footer -->
            <TextBlock x:Name="FooterText"
                       Text="Cache — · Click for details"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FgMutedBrush}"
                       FontSize="10.5" />
        </StackPanel>
    </Border>
</Window>
