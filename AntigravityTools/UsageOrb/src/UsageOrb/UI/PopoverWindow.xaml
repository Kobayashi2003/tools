<Window x:Class="UsageOrb.UI.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="368"
        ResizeMode="NoResize">
    <Border Margin="10"
            CornerRadius="14"
            Background="{DynamicResource BgElevatedBrush}"
            BorderBrush="{DynamicResource BorderPrimaryBrush}"
            BorderThickness="1"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.52" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Top Bar: Vector Ring Logo + Brand + Plan + Controls -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Concentric Dual-Ring Vector Logo -->
                    <Grid Width="20" Height="20" Margin="0,0,8,0">
                        <Ellipse Stroke="{DynamicResource CyanBrush}" StrokeThickness="2" />
                        <Ellipse Width="12" Height="12" Stroke="{DynamicResource OkBrush}" StrokeThickness="1.6" />
                    </Grid>
                    <TextBlock Text="UsageOrb"
                               Foreground="{DynamicResource FgPrimaryBrush}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Refresh Icon Button -->
                <Button x:Name="RefreshBtn"
                        Grid.Column="2"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Refresh now (0 tokens)"
                        Margin="0,0,2,0">
                    <Path Data="M 11,4 A 5,5 0 1 0 12.2,8.5 M 11,1.5 L 11,4.5 L 8,4.5"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>

                <!-- Close Icon Button -->
                <Button x:Name="CloseBtn"
                        Grid.Column="3"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Close (Esc)">
                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                          Width="11" Height="11"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" />
                </Button>
            </Grid>

            <!-- Compact Session Switcher -->
            <ComboBox x:Name="SessionCombo"
                      Margin="0,0,0,10"
                      FontSize="11.5" />

            <!-- Optional Alert Banner -->
            <Border x:Name="AlertBanner"
                    Visibility="Collapsed"
                    Margin="0,0,0,10"
                    Padding="10,7"
                    CornerRadius="8"
                    Background="{DynamicResource WarnBgBrush}"
                    BorderBrush="{DynamicResource WarnBrush}"
                    BorderThickness="2,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="AlertTitle" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AlertBody" FontSize="10.5" Foreground="{DynamicResource FgSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,12" />

            <!-- BIG-3 HERO STACK -->
            <!-- 1. Context Window -->
            <StackPanel Margin="0,0,0,13">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Context Window"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="Over200kBadge"
                                Visibility="Collapsed"
                                Margin="6,0,0,0"
                                Padding="5,1"
                                CornerRadius="4"
                                Background="{DynamicResource WarnBgBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&gt;200K" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ContextPctText"
                               Grid.Column="1"
                               FontFamily="Consolas"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FgPrimaryBrush}" />
                </Grid>

                <!-- Multi-segment stacked context bar -->
                <Border Height="6.5" CornerRadius="3.25" Background="{DynamicResource TrackBrush}" ClipToBounds="True" Margin="0,0,0,5">
                    <Grid x:Name="StackedBarGrid" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ContextSubText" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
                    <TextBlock x:Name="ModelTagText" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource FgSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- 2. 5-Hour Remaining -->
            <StackPanel Margin="0,0,0,13">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="5-Hour Remaining"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="FiveHourBadge" Margin="7,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource BgTertiaryBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="FiveHourBadgeText" Text="Est." FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="FiveHourPctText"
                               Grid.Column="1"
                               FontFamily="Consolas"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OkBrush}" />
                </Grid>

                <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackBrush}" ClipToBounds="True" Margin="0,0,0,5">
                    <Grid x:Name="FiveHourBarGrid" />
                </Border>

                <TextBlock x:Name="FiveHourSubText" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
            </StackPanel>

            <!-- 3. Weekly Remaining -->
            <StackPanel Margin="0,0,0,13">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Weekly Remaining"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="WeeklyBadge" Margin="7,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource BgTertiaryBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="WeeklyBadgeText" Text="Est." FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource FgMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="WeeklyPctText"
                               Grid.Column="1"
                               FontFamily="Consolas"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarnBrush}" />
                </Grid>

                <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackBrush}" ClipToBounds="True" Margin="0,0,0,5">
                    <Grid x:Name="WeeklyBarGrid" />
                </Border>

                <TextBlock x:Name="WeeklySubText" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,11" />

            <!-- 3-Stat Strip -->
            <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Cache Hit" FontSize="10.5" Foreground="{DynamicResource FgMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CacheHitMetric" Text="—" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,3" />

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Last Δ" FontSize="10.5" Foreground="{DynamicResource FgMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LastDeltaMetric" Text="—" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource BorderSubtleBrush}" Margin="0,3" />

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="Compactions" FontSize="10.5" Foreground="{DynamicResource FgMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompactionsMetric" Text="0" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Action Row: Ghost Copy + High-Contrast White Manage Usage -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CopyBtn" Grid.Column="0" Style="{StaticResource GhostBtn}" Padding="13,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 4,4 L 4,11 L 10,11 L 10,4 Z M 6,4 L 6,2 L 12,2 L 12,9 L 10,9"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Stroke="{DynamicResource FgSecondaryBrush}"
                              StrokeThickness="1.3"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="CopyBtnText" Text="Copy" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ManageBtn" Grid.Column="2" Style="{StaticResource PrimaryCtaBtn}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Manage Usage" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Path Data="M 2,10 L 10,2 M 4,2 L 10,2 L 10,8"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource CtaFgBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
