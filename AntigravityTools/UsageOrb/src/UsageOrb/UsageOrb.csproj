<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UsageOrb</AssemblyName>
    <RootNamespace>UsageOrb</RootNamespace>
    <StartupObject>UsageOrb.Program</StartupObject>
    <ApplicationIcon>Assets\UsageOrb.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.0.0</Version>
    <Authors>Local Personal Tools</Authors>
    <Description>Floating telemetry orb, popover, and management console for Google Antigravity quotas and session context windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsageOrb.Tests" />
  </ItemGroup>

</Project>
