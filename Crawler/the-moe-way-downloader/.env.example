# Copy to .env and fill in. Real environment variables win over this file.
#
# TMW_TOKEN is your Discord *account token*, not a cookie. Discord's REST API
# ignores the session cookies entirely and authenticates on an `Authorization`
# header, so a cookie export cannot be used here.
#
# To read yours: open Discord in the browser, F12 -> Network, click any channel,
# find a request to /api/v9/... and copy the `Authorization` request header.
# It is the password to your whole account -- keep it in .env, which .gitignore
# already excludes, and never paste it anywhere else.
TMW_TOKEN=

# Optional.
TMW_PROXY=
TMW_PORT=8420
TMW_CACHE_DIR=cache
TMW_STATE_FILE=state.json
