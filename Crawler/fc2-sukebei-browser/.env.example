# Copy to .env to override defaults. Real environment variables win over this file.

# Port of the local Web UI (binds to 127.0.0.1 only).
FC2SB_PORT=18050

# Proxy for every request, e.g. http://127.0.0.1:7890.
# Leave empty to use HTTP_PROXY / HTTPS_PROXY from the environment.
FC2SB_PROXY=

# Where the SQLite library and media cache live (relative to this folder).
FC2SB_DATA_DIR=data

# Parallel metadata lookups. Each site is still paced individually.
FC2SB_WORKERS=3

# Seconds between requests to sukebei, to FC2, and to paipancon pages.
FC2SB_SUKEBEI_DELAY=1.5
FC2SB_SOURCE_DELAY=0.5
# paipancon answers HTTP 429 above ~10 pages per minute.
FC2SB_PAIPANCON_DELAY=6

# Fetch new uploads automatically when the last Update is older than N minutes (0 = off).
FC2SB_WATCH_MINUTES=30
FC2SB_DEFAULT_QUERY=FC2
