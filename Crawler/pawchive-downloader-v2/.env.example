# Copy to `.env`. Real environment variables win; then .env; then data/config.json.
# Any setting can be set here as PAWCHIVE_<NAME>; these are the ones that vary per machine.

# PAWCHIVE_DATA_DIR=data
# PAWCHIVE_DOWNLOAD_DIR=F:/Download/kemono

# Proxy (requests reads the standard names)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Fanbox session cookie; overrides the one saved from the UI.
# FANBOX_SESSID=
# Browser for "Sign in with browser" when Chrome or Edge is not in the usual place.
# PAWCHIVE_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Pawchive's operator asks for at most 1 request/s and 5 active downloads.
# PAWCHIVE_MAX_FILE_REQUESTS_PER_SECOND=1
# PAWCHIVE_MAX_CONCURRENT_DOWNLOADS=4
# PAWCHIVE_DAILY_DOWNLOAD_QUOTA=100GB

# Fanbox requests go out under your account.
# PAWCHIVE_FANBOX_REQUESTS_PER_SECOND=0.5

# Per-status retry rules, e.g.
# PAWCHIVE_STATUS_POLICIES=429=retry,attempts=10,delay=120,backoff=1; 5xx=retry,attempts=6,delay=15
